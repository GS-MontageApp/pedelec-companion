{
  "name": "pedelec-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "node scripts/test-mobile.cjs && node scripts/test-finish.cjs",
    "typecheck": "tsc -b",
    "test:phase1": "node scripts/test-phase1.cjs",
    "test:pwa": "node scripts/test-pwa.cjs",
    "test:active-ride": "node scripts/test-active-ride.cjs",
    "test:ride-management": "node scripts/test-ride-management.cjs",
    "test:soc-journey": "node scripts/test-soc-journey.cjs"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "workbox-window": "7.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "playwright": "1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "0.21.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
